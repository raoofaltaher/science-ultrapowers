#!/usr/bin/env bash
# UserPromptSubmit hook for the science-ultrapowers plugin: a one-line lab
# memory reminder. Prints nothing and exits 0 unless a lab memory store
# (research_lab/memory/MEMORY.md) exists at or above the session's working
# directory. Never writes anything.

set -euo pipefail

# Split $0 on its last / or \ instead of calling dirname: a hook can run with a
# broken or empty PATH.
case "$0" in
  */*|*\\*) SCRIPT_DIR="$(cd "${0%[/\\]*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
# shellcheck source=lib/memory-common
. "${SCRIPT_DIR}/lib/memory-common"

if nudge_off; then
  exit 0
fi

input="$(read_hook_input)"
cwd="$(hook_cwd "$input")"

store="$(find_memory_store "$cwd")" || exit 0

emit_context "UserPromptSubmit" "Lab memory: if this session verified a durable, expensive-to-rediscover fact that no lab record holds, gate it and save it with science-ultrapowers:remembering-for-the-lab (store: ${store})."
exit 0
